<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.5</version>
        <relativePath/>
    </parent>

    <groupId>com.company</groupId>
    <artifactId>ai-qa-platform</artifactId>
    <version>0.1.0</version>
    <name>ai-qa-platform</name>
    <description>Git-diff driven, LLM-powered automatic test case generator</description>

    <properties>
        <java.version>17</java.version>
        <javaparser.version>3.25.10</javaparser.version>
        <jgit.version>6.9.0.202403050737-r</jgit.version>
        <rest-assured.version>5.4.0</rest-assured.version>
        <testng.version>7.10.2</testng.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Explicit (rather than relying on the transitive copy via
             spring-boot-starter-web) so ObjectMapper/JsonNode resolve
             cleanly even before a full Spring context is on the classpath -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Git diff extraction -->
        <dependency>
            <groupId>org.eclipse.jgit</groupId>
            <artifactId>org.eclipse.jgit</artifactId>
            <version>${jgit.version}</version>
        </dependency>

        <!-- Java source parsing / AST -->
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>
        <dependency>
            <groupId>com.github.javaparser</groupId>
            <artifactId>javaparser-symbol-solver-core</artifactId>
            <version>${javaparser.version}</version>
        </dependency>

        <!-- Execution engine (see the execution package). COMPILE scope, not test
             scope, deliberately: these must be on the classpath used to compile AND
             run generated automation scripts at request-serving time, not merely for
             this project's own tests. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <version>${rest-assured.version}</version>
        </dependency>
        <!-- The test framework generated scripts are written in, and whose
             org.testng.TestNG main class the runner shells out to. TestNG rather
             than JUnit because it ships its own runnable CLI and its own HTML +
             XML reporters, so execution and reporting need no extra launcher
             artifact - and testng-results.xml carries per-method timings and
             exception detail that the platform parses back into the API response.

             Note this replaced junit-platform-console-standalone: that artifact
             is a shaded fat jar bundling its own JUnit Jupiter, which collided
             with the copy spring-boot-starter-test puts on the test classpath. -->
        <dependency>
            <groupId>org.testng</groupId>
            <artifactId>testng</artifactId>
            <version>${testng.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
